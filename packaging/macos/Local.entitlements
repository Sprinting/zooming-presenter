<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Test builds signed without an Apple team (ad-hoc or a self-signed
     certificate) only. The hardened runtime loads a library only from the
     same team, and such a signature has none, so PDFium would be refused.
     Developer ID and App Store builds have a team and don't use this. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
