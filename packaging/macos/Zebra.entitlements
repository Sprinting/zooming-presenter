<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Mac App Store build only. TEAMID is a placeholder; it must match
     APP_GROUP_ID in zebra-api/src/discovery.rs. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.files.user-selected.read-write</key><true/>
  <key>com.apple.security.application-groups</key>
  <array><string>ZEBRATEAM.app.zebra</string></array>
  <!-- Web videos (Insert > Web Video...). App Review note: "Zebra plays
       video from links the user adds." Outgoing connections only: a link
       is checked, played or downloaded when the person inserts, plays,
       previews or presents it; opening a deck connects to nothing. The
       bundled zebractl needs none of this: it asks the app, which checks
       the link. -->
  <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
