<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The bundled zebractl in a Mac App Store build. It must be sandboxed
     too; `inherit` is NOT used because agents launch it directly, not
     Zebra. It reaches the app only through the shared App Group. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.application-groups</key>
  <array><string>ZEBRATEAM.app.zebra</string></array>
  <!-- screenshot/export -o write where the agent asks; under the sandbox
       that is limited to the container unless this is added: -->
  <key>com.apple.security.files.user-selected.read-write</key><true/>
</dict>
</plist>
